rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Funciones auxiliares
    // ------------------------------------------------------------------
    function estaLogueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function esDueno(uid) {
      return estaLogueado() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // PRODUCTOS
    // Lectura: pública (el catálogo se muestra a cualquiera, con o sin login).
    // Alta / edición completa / borrado: solo el administrador.
    // Excepción puntual: se permite que CUALQUIERA baje el campo "stock"
    // de un producto (sin tocar ningún otro campo, sin poder subirlo ni
    // dejarlo negativo) para que el checkout por WhatsApp pueda descontar
    // stock automáticamente sin necesidad de un backend propio.
    // ------------------------------------------------------------------
    match /productos/{productId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    // ------------------------------------------------------------------
    // VARIANTES DE PRODUCTO (talle / color / etc.)
    // Subcolección opcional dentro de cada producto: productos/{id}/variantes/{varId}.
    // Mismo criterio que "productos": lectura pública, alta/edición completa/
    // borrado solo admin, y una excepción puntual para que cualquiera pueda
    // descontar (nunca aumentar) el stock de una variante puntual al comprar.
    // ------------------------------------------------------------------
    match /productos/{productId}/variantes/{varianteId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    // ------------------------------------------------------------------
    // SLIDER (HERO)
    // ------------------------------------------------------------------
    match /hero/{slideId} {
      allow read: if true;
      allow write: if esAdmin();
    }

// ------------------------------------------------------------------
    // CLIENTES MAYORISTAS / REGISTRO DE USUARIOS (CORREGIDO)
    // ------------------------------------------------------------------
    match /usuarios/{uid} {
      // Permitimos lectura para consultar disponibilidad de usuarios / perfiles propios
      allow read: if true;
      
      // Permitimos crear el documento si el usuario está autenticado O si es el registro inicial obligatorio con activo: false
      allow create: if (esDueno(uid) || estaLogueado()) && request.resource.data.activo == false;
      
      // Solo el admin puede activar/modificar el perfil, o el dueño sin alterar su estado "activo"
      allow update: if esAdmin() || (
        esDueno(uid) &&
        request.resource.data.activo == resource.data.activo
      );
      
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------------
    // PEDIDOS
    // Cualquiera (incluso sin login) puede generar un pedido desde el
    // checkout. El administrador puede leer y borrar todos. Un cliente
    // logueado puede leer (no borrar) los pedidos que le pertenecen a él
    // (clienteUid == su propio uid), para mostrarle su propio historial.
    // ------------------------------------------------------------------
    match /pedidos/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['detalle','total','fecha'])
                    && request.resource.data.detalle is string
                    && request.resource.data.total is string
                    && (
                         !('clienteUid' in request.resource.data) ||
                         request.resource.data.clienteUid == null ||
                         (estaLogueado() && request.resource.data.clienteUid == request.auth.uid)
                       );
      allow read: if esAdmin() || (estaLogueado() && resource.data.clienteUid == request.auth.uid);
      allow delete: if esAdmin();
      allow update: if false;
    }

    // ------------------------------------------------------------------
    // CONFIGURACIÓN DE ALTA DEL ADMINISTRADOR
    // Documento único config/setup con el email autorizado a convertirse en
    // administrador (lo carga a mano quien configura el proyecto en
    // Firebase — ver README.md → "Alta de un cliente nuevo"). Nunca se
    // escribe desde la web, y solo lo puede leer el propio email que
    // coincide (y ya con el email verificado).
    // ------------------------------------------------------------------
    match /config/setup {
      allow read: if estaLogueado()
                  && request.auth.token.email_verified == true
                  && request.auth.token.email == resource.data.allowedAdminEmail;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // CONFIG/TIENDA — marca, tema, categorías, mapa, etc. de esta tienda.
    // Lectura pública (el sitio la necesita para pintar la tienda incluso
    // sin login). Escritura solo admin (panel → pestaña Configuración).
    // ------------------------------------------------------------------
    match /config/tienda {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ------------------------------------------------------------------
    // ADMINISTRADORES
    // No hay contraseña "de fábrica" en el código: para convertirse en
    // administrador hay que crear una cuenta con el email exacto que se
    // autorizó en config/setup Y haber verificado ese email por correo
    // (request.auth.token.email_verified). Esto evita que alguien pueda
    // adivinar/copiar ese email y auto-asignarse como admin sin controlar
    // esa casilla de correo de verdad.
    // ------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
                    && request.auth.token.email_verified == true
                    && exists(/databases/$(database)/documents/config/setup)
                    && request.auth.token.email == get(/databases/$(database)/documents/config/setup).data.allowedAdminEmail;
      allow update, delete: if false;
    }
  }
}
