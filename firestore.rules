rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Funciones auxiliares
    // ------------------------------------------------------------------
    function estaLogueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function esDueno(uid) {
      return estaLogueado() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // PRODUCTOS
    // Lectura: pública (el catálogo se muestra a cualquiera, con o sin login).
    // Alta / edición completa / borrado: solo el administrador.
    // Excepción puntual: se permite que CUALQUIERA baje el campo "stock"
    // de un producto (sin tocar ningún otro campo, sin poder subirlo ni
    // dejarlo negativo) para que el checkout por WhatsApp pueda descontar
    // stock automáticamente sin necesidad de un backend propio.
    // ------------------------------------------------------------------
    match /productos/{productId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    // ------------------------------------------------------------------
    // VARIANTES DE PRODUCTO (talle / color / etc.)
    // Subcolección opcional dentro de cada producto: productos/{id}/variantes/{varId}.
    // Mismo criterio que "productos": lectura pública, alta/edición completa/
    // borrado solo admin, y una excepción puntual para que cualquiera pueda
    // descontar (nunca aumentar) el stock de una variante puntual al comprar.
    // ------------------------------------------------------------------
    match /productos/{productId}/variantes/{varianteId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    // ------------------------------------------------------------------
    // SLIDER (HERO)
    // ------------------------------------------------------------------
    match /hero/{slideId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ------------------------------------------------------------------
    // CLIENTES MAYORISTAS
    // El documento de cada cliente vive en usuarios/{uid}, donde {uid} es
    // su propio ID de Firebase Authentication. Cada cliente solo puede
    // crear y leer SU PROPIO perfil, nunca el de otro. No puede
    // autoaprobarse: el campo "activo" nace en false y solo el
    // administrador puede cambiarlo a true.
    // ------------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid) && request.resource.data.activo == false;
      allow update: if esAdmin() || (
        esDueno(uid) &&
        request.resource.data.activo == resource.data.activo
      );
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------------
    // PEDIDOS
    // Cualquiera (incluso sin login) puede generar un pedido desde el
    // checkout. Solo el administrador puede leerlos o borrarlos desde el
    // panel. Se valida que traiga los campos mínimos esperados.
    // ------------------------------------------------------------------
    match /pedidos/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['detalle','total','fecha'])
                    && request.resource.data.detalle is string
                    && request.resource.data.total is string;
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // ------------------------------------------------------------------
    // ADMINISTRADORES
    // Esta colección NUNCA se escribe desde la web (allow write: if false).
    // Se agrega manualmente desde la consola de Firebase al dar de alta al
    // primer administrador de cada cliente. Ver README.md → "Alta de un
    // cliente nuevo".
    // ------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;
    }
  }
}
